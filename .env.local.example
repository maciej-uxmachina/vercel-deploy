# Copy to .env.local and fill in values from your Vercel Postgres database.
# In Vercel dashboard: Storage → your Postgres db → .env.local tab → copy snippet.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
